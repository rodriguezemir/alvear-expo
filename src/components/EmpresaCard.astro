---
/**
 * Tarjeta de un emprendimiento escolar.
 *
 * Registra el emprendimiento: foto del producto, nombre, curso y actividad.
 * El precio y el stock no van en la tarjeta porque la referencia original los
 * muestra como "a confirmar" y el sitio no tiene todavia el sincronizado con
 * la base central.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	empresa: CollectionEntry<'empresas'>;
	/** ImageMetadata de la foto de portada, ya resuelta por la pagina. */
	portada: ImageMetadata;
	/** Atributos data-* que usa el filtro de la pagina. */
	[nombre: string]: unknown;
}

const { empresa, portada, ...atributos } = Astro.props;
const { nombre, slug, curso, producto, actividad, integrantes } = empresa.data;

const cursoLabel = curso ? `${curso}°` : 'Sin curso asignado';
---

<article
	class="group flex flex-col overflow-hidden border border-rule bg-white transition-colors hover:border-ink/40"
	{...atributos}
>
	<a href={`/empresas/${slug}/`} class="block focus-visible:outline-2 focus-visible:outline-offset-2">
		<div class="relative overflow-hidden bg-[#eef4f7]">
			<Image
				src={portada}
				alt={`${nombre} — ${producto}`}
				widths={[320, 480, 640]}
				sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
				loading="lazy"
				decoding="async"
				class="aspect-4/3 w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.03]"
			/>
		</div>

		<div class="flex flex-1 flex-col gap-3 p-5">
			<div class="flex items-center justify-between gap-3">
				<span
					class="font-mono text-[0.6875rem] tracking-[0.16em] text-bordo uppercase"
				>
					{cursoLabel}
				</span>
				<span class="font-mono text-[0.6875rem] tracking-[0.14em] text-muted uppercase">
					{empresa.data.productos[0].precio ? `$${empresa.data.productos[0].precio}` : 'A confirmar'}
				</span>
			</div>

			<h3 class="font-display text-xl leading-tight font-semibold text-ink">
				{nombre}
			</h3>

			<p class="text-sm text-muted">
				<span class="text-ink">{producto}</span> — {actividad}
			</p>

			{
				integrantes && (
					<p class="mt-auto pt-2 font-mono text-[0.6875rem] leading-relaxed tracking-[0.1em] text-muted uppercase">
						{integrantes}
					</p>
				)
			}
		</div>
	</a>
</article>
